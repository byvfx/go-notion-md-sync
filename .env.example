# Copy this file to .env and fill in your actual values
# Get your integration token from: https://www.notion.so/my-integrations

# Your Notion integration token (required)
NOTION_MD_SYNC_NOTION_TOKEN=your_notion_integration_token_here

# Your Notion parent page ID (32-character hex string from the page URL, required)
NOTION_MD_SYNC_NOTION_PARENT_PAGE_ID=your_parent_page_id_here

# Optional override of the Notion API address (default https://api.notion.com/v1), for a gateway or local server.
# NOTION_MD_SYNC_API_URL=

# Direction, conflict resolution, markdown root, and workers come from config.yaml.
